# ==============================================================================
# PCYC Space — Environment Configuration Template
# Copy this file to .env.local for local development.
# In production, set these variables in your Vercel Project Settings.
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Public Anon Key (safe for client-side, protected by Postgres RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Secret Service Role Key (SERVER-SIDE ONLY - NEVER expose to browser!)
# Used for administrative actions, bypassing RLS when strictly necessary
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# PostgreSQL / Drizzle Database Connection
# Obtain from Supabase Project Settings -> Database -> Connection string (URI)
# Use Transaction Pooler (port 6543) or Session Pooler (port 5432)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Direct URL for Drizzle migrations (Session mode, port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# Resend Email Service
# Obtain API key from https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuv"
EMAIL_FROM="PCYC Space <notifications@pcyc.ph>"

# ------------------------------------------------------------------------------
# Observability & Logging
# Options: trace | debug | info | warn | error | fatal
# ------------------------------------------------------------------------------
LOG_LEVEL="info"
